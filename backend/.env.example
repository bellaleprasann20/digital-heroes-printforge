
# ==========================================
# DIGITAL HEROES PRINTFORGE - BACKEND
# ==========================================

# Application
NODE_ENV=development
PORT=5000
APP_NAME=Digital Heroes PrintForge

# Frontend URL
# Multiple origins can be separated by commas.
CLIENT_URL=http://localhost:5173

# ==========================================
# SUPABASE
# ==========================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Private Supabase Storage bucket
STORAGE_BUCKET=printforge-files

# ==========================================
# RAZORPAY
# ==========================================

RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ==========================================
# OPTIONAL CONFIGURATION
# ==========================================

# API
API_PREFIX=/api

# Upload limits
MAX_FILE_SIZE_MB=20
MAX_UPLOAD_FILES=10

# Print defaults
DEFAULT_PRINT_DPI=300
DEFAULT_BLEED_MM=3
DEFAULT_SAFE_MARGIN_MM=3

# Email configuration (configure when email service is implemented)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
