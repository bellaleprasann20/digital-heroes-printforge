{
  "name": "digital-heroes-printforge-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for Digital Heroes PrintForge web-to-print platform",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test tests/*.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "check": "node --check src/server.js && node --check src/app.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.57.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "fontkit": "^2.0.4",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "minimatch": "^11.0.9"
  }
}
